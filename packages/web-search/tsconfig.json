{
  "compilerOptions": {
    "target": "es2024",
    // Both halves share one program, so both environments are declared: `dom`
    // for the settings card, `types: ["node"]` for the tool (which is where
    // `fetch` comes from — `dom` would resolve it too, but by way of a lib the
    // Host half has no business reading). What actually keeps the halves apart
    // is the build: tsdown emits them with `platform: node` and
    // `platform: browser` from separate entries.
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": ["node"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src"]
}
